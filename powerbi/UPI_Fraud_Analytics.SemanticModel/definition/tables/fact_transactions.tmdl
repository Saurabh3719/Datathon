				    #"Added TxnDate" = Table.AddColumn(#"Changed Type", "TxnDate", each try Date.From([timestamp]) otherwise null, type date),
				    #"Errors Replaced" = Table.ReplaceErrorValues(#"Added TxnDate", List.Transform(Table.ColumnNames(#"Added TxnDate"), each {_, null}))
				in
