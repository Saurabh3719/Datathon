	column MerchantNameDisplay = IF(ISBLANK(dim_merchants[merchant_name]) || dim_merchants[merchant_name] = "", "No Matching Merchant", dim_merchants[merchant_name])
		lineageTag: 21710490-4c3a-43f0-9789-df0f40434395
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

