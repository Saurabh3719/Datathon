		summarizeBy: none
		sourceColumn: declared_avg_ticket_size_was_negative

		annotation SummarizationSetBy = Automatic

	column DisputeRiskFlag = IF(ISBLANK(dim_merchants[merchant_id]), "No Matching Merchant", VAR CB = COUNTROWS(RELATEDTABLE(fact_chargebacks)) RETURN SWITCH(TRUE(), CB >= 2, "Repeat (2+) Disputes", CB = 1, "Single Dispute", "No Disputes"))
		lineageTag: 580383bf-6225-456a-935a-78c88da646ac
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HadSpikeDay =
			IF(ISBLANK(dim_merchants[merchant_id]), "No Matching Merchant", VAR T = RELATEDTABLE(fact_transactions)
			VAR SpikeDays = COUNTROWS(FILTER(SUMMARIZE(T, fact_transactions[TxnDate], "C", COUNTROWS(fact_transactions)), [C] >= 2))
			RETURN IF(SpikeDays > 0, "Spike Day (2+ same-day txns)", "Normal"))
		lineageTag: ba2d7a99-e843-4269-8f0d-c697ad50a448
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column MerchantCategoryDisplay = IF(ISBLANK(dim_merchants[merchant_category]) || dim_merchants[merchant_category] = "", "No Matching Merchant", dim_merchants[merchant_category])
		lineageTag: 084082a4-be55-42a4-9ee5-b0019a576c49
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column MerchantStatusDisplay = IF(ISBLANK(dim_merchants[merchant_status]) || dim_merchants[merchant_status] = "", "No Matching Merchant", dim_merchants[merchant_status])
		lineageTag: 58286d3d-b2b2-4875-ba4a-62e7d59fe2dc
