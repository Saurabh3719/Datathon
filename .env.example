# Copy this file to `.env` (never commit the real `.env`) and fill in your
# own key to enable the OpenRouter fallback in agent/openrouter_client.py.
# Without this, the text-to-SQL agent still works fully -- it just can't
# answer questions outside its ~21 local templates (see agent/README.md).
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model. See https://openrouter.ai/models
# for current options, including free-tier models (filter by max price $0).
# OPENROUTER_MODEL=openai/gpt-4o-mini
